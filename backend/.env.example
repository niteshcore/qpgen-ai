# Copy this file to backend/.env and fill in real values.
# backend/.env is gitignored — never commit real secrets.

# Required for AI question generation (Google AI Studio -> Get API Key)
GOOGLE_API_KEY=

# Flask session / JWT signing secrets — generate real random values for anything
# beyond local dev, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-only-change-me
JWT_SECRET_KEY=dev-only-change-me
JWT_ACCESS_TOKEN_EXPIRES=3600

# Password for the auto-seeded admin account (admin@qpgen.com) on first run
ADMIN_DEFAULT_PASSWORD=admin123

# Only used in production config; omit locally to use SQLite
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Token required to hit POST /api/setup for initializing a persistent prod DB
# SETUP_TOKEN=
